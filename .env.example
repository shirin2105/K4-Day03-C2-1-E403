# =============================================================================
# ⚙️ CẤU HÌNH MULTI-PROVIDER LLM ADAPTER
# =============================================================================

# -----------------------------------------------------------------------------
# 📌 BƯỚC 1: CHỌN NHÀ CUNG CẤP AI (LLM_PROVIDER)
# Chọn 1 trong các giá trị sau: gemini | openai | anthropic | openrouter | huggingface | mock
# -----------------------------------------------------------------------------
LLM_PROVIDER=huggingface

# -----------------------------------------------------------------------------
# 📌 BƯỚC 2: ĐIỀN API KEY CHO PROVIDER ĐÃ CHỌN Ở BƯỚC 1
# -----------------------------------------------------------------------------
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# 📌 BƯỚC 3: (TÙY CHỌN) GHI ĐÈ TÊN MODEL CỤ THỂ (LLM_MODEL)
# 
# 💡 Mặc định nếu ĐỂ TRỐNG (LLM_MODEL=), hệ thống tự dùng Model chuẩn của Provider:
#   - Nếu chọn LLM_PROVIDER=huggingface ➔ Mặc định dùng: Qwen/Qwen2.5-1.5B-Instruct (~2.9GB - Rất mạnh & Nhẹ)
#   - Nếu chọn LLM_PROVIDER=gemini      ➔ Mặc định dùng: gemini-2.5-flash
#   - Nếu chọn LLM_PROVIDER=openai      ➔ Mặc định dùng: gpt-4o-mini
#   - Nếu chọn LLM_PROVIDER=anthropic   ➔ Mặc định dùng: claude-3-haiku-20240307
#   - Nếu chọn LLM_PROVIDER=openrouter  ➔ Mặc định dùng: google/gemini-2.5-flash
#
# ✏️ Ví dụ các Model Open Source SIÊU NHẸ (DƯỚI 3GB) chuyên dùng để test:
# LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct     # ~2.9GB (Khuyên dùng: Suy luận & Tiếng Việt tốt)
# LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct     # ~1.0GB (Siêu nhẹ, phản hồi tức thì)
# LLM_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct # ~3.2GB (Model siêu nhỏ của HuggingFace)
# -----------------------------------------------------------------------------
LLM_MODEL=
